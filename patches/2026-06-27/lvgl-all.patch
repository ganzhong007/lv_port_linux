+uint32_t lv_gpu_composite_gles2_2d_queue_count(void)
+{
+    return g_queue_count;
+}
+
+bool lv_gpu_composite_gles2_2d_is_raster_nest(void)
+{
+    return g_raster_nest > 0;
+}
