# LVGL 2D/3D — GLFW dev simulator (Phase 1)
# Build: cmake -B build-vgl -DCONFIG=lvgl2d3dbackend-glfw && cmake --build build-vgl -j

LV_USE_GLFW 1
LV_USE_OPENGLES 1

LV_USE_DRAW_NANOVG 0
LV_USE_NANOVG 0
LV_USE_DRAW_OPENGLES 0
LV_USE_DRAW_GPU_RENDERER 1
LV_USE_GPU_RENDERER 1

LV_USE_3D 1
LV_USE_3D_WIDGETS 1
LV_USE_3DBUTTON 1
LV_USE_3D_OBJ_PROPERTIES 0
LV_USE_3DTEXTURE_LEGACY 0
LV_USE_3DTEXTURE 0
LV_USE_GLTF 0

LV_GPU_RENDERER_AR_PASSTHROUGH 1
LV_GPU_RENDERER_GLES_API 2
LV_GPU_RENDERER_ALLOW_GLES3 0
LV_GPU_RENDERER_DEPTH_BITS 16
LV_GPU_RENDERER_USE_ETC1 1
LV_GPU_RENDERER_LOG_CAPS 1
LV_GPU_RENDERER_MSAA_SAMPLES 4
LV_USE_3DSTACK 1
LV_USE_3D_SEGMENT_POOL 1
LV_USE_SNAPSHOT 1
LV_USE_APPWINDOW 1

LV_COLOR_DEPTH 32

LV_BUILD_EXAMPLES 0
LV_BUILD_DEMOS 0

LV_USE_LOG 1
LV_LOG_LEVEL LV_LOG_LEVEL_WARN
LV_LOG_PRINTF 1

LV_USE_FLOAT 1
LV_USE_MATRIX 1

LV_USE_STDLIB_MALLOC LV_STDLIB_CLIB
LV_USE_STDLIB_STRING LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF LV_STDLIB_CLIB

LV_FONT_MONTSERRAT_14 1
LV_FONT_MONTSERRAT_48 1
LV_FONT_SOURCE_HAN_SANS_SC_14_CJK 1
