# LVGL 2D/3D — GLFW dev simulator (Phase 1)
# Build: cmake -B build-vgl -DCONFIG=lvgl2d3dbackend-glfw && cmake --build build-vgl -j

LV_USE_GLFW 1
LV_USE_OPENGLES 1

LV_USE_DRAW_NANOVG 0
LV_USE_NANOVG 0
LV_USE_DRAW_OPENGLES 0
LV_USE_DRAW_GPU_COMPOSITE 1
LV_USE_GPU_COMPOSITE 1

LV_USE_3D 1
LV_USE_3D_WIDGETS 1
LV_USE_3D_OBJ_PROPERTIES 0
LV_USE_3DTEXTURE_LEGACY 0
LV_USE_3DTEXTURE 0
LV_USE_GLTF 0

LV_GPU_COMPOSITE_AR_PASSTHROUGH 1
LV_GPU_COMPOSITE_GLES_API 2
LV_GPU_COMPOSITE_ALLOW_GLES3 0
LV_GPU_COMPOSITE_DEPTH_BITS 16
LV_GPU_COMPOSITE_USE_ETC1 1
LV_GPU_COMPOSITE_LOG_CAPS 1
LV_USE_3DSTACK 1
LV_USE_3D_SEGMENT_POOL 0

LV_COLOR_DEPTH 32

LV_BUILD_EXAMPLES 0
LV_BUILD_DEMOS 0

LV_USE_LOG 1
LV_LOG_LEVEL LV_LOG_LEVEL_WARN
LV_LOG_PRINTF 1

LV_USE_FLOAT 1
LV_USE_MATRIX 1

LV_USE_STDLIB_MALLOC LV_STDLIB_CLIB
LV_USE_STDLIB_STRING LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF LV_STDLIB_CLIB

LV_FONT_MONTSERRAT_14 1
