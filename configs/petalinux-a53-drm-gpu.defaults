# PetaLinux AArch64 (ZynqMP + Mali) — DRM/KMS + EGL + gpu_renderer
# Display panel: RGB888 (EGL/GBM scanout); LVGL internal draw stays 32-bit for alpha.
# Build: LVGL_PLNX_CONFIG=petalinux-a53-drm-gpu ./scripts/build_petalinux.sh
# Run:   ./scripts/start_mali_gpu.sh && LVGL_SCENARIO=4 ./lvglsim -b drm

LV_COLOR_DEPTH 32

LV_USE_LINUX_DRM 1
LV_USE_OPENGLES 1

LV_USE_DRAW_NANOVG 0
LV_USE_NANOVG 0
LV_USE_DRAW_OPENGLES 0
LV_USE_DRAW_GPU_RENDERER 1
LV_USE_GPU_RENDERER 1

LV_USE_3D 1
LV_USE_3D_WIDGETS 1
LV_USE_3DBUTTON 1
LV_USE_3D_OBJ_PROPERTIES 0
LV_USE_3DTEXTURE_LEGACY 0
LV_USE_3DTEXTURE 0
LV_USE_GLTF 0

LV_GPU_RENDERER_AR_PASSTHROUGH 1
LV_GPU_RENDERER_GLES_API 2
LV_GPU_RENDERER_ALLOW_GLES3 0
LV_GPU_RENDERER_DEPTH_BITS 16
LV_GPU_RENDERER_USE_ETC1 1
LV_GPU_RENDERER_LOG_CAPS 1
LV_GPU_RENDERER_MSAA_SAMPLES 0

LV_USE_3DSTACK 1
LV_USE_3D_SEGMENT_POOL 1
LV_USE_SNAPSHOT 1
LV_USE_APPWINDOW 1

LV_USE_LINUX_FBDEV 1
LV_LINUX_FBDEV_RENDER_MODE LV_DISPLAY_RENDER_MODE_DIRECT
LV_LINUX_FBDEV_BUFFER_COUNT 2
LV_USE_GLFW 0
LV_USE_WAYLAND 0

LV_USE_EVDEV 1
LV_USE_LIBINPUT 0

LV_BUILD_EXAMPLES 0
LV_BUILD_DEMOS 0

LV_USE_LOG 1
LV_LOG_LEVEL LV_LOG_LEVEL_WARN
LV_LOG_PRINTF 1

LV_USE_FLOAT 1
LV_USE_MATRIX 1

LV_USE_STDLIB_MALLOC LV_STDLIB_CLIB
LV_USE_STDLIB_STRING LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF LV_STDLIB_CLIB

LV_FONT_MONTSERRAT_14 1
LV_FONT_MONTSERRAT_48 1
LV_FONT_SOURCE_HAN_SANS_SC_14_CJK 1

LV_USE_FREETYPE 1
LV_FREETYPE_USE_LVGL_PORT 0
LV_FREETYPE_CACHE_FT_GLYPH_CNT 256

LV_USE_VECTOR_GRAPHIC 1
LV_USE_THORVG_INTERNAL 1
