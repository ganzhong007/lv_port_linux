# Orange Pi PC (Allwinner H3, Mali-400/lima, GLES2 only) — Wayland-EGL + EVGPU.
# Based on orangepi-evgpu-only.defaults + G3_SHOWCASE + EVGPU_BENCHMARK

LV_COLOR_DEPTH 32
LV_DEF_REFR_PERIOD 16

LV_USE_WAYLAND 1
LV_WAYLAND_WINDOW_DECORATIONS 0
LV_WAYLAND_DIRECT_EXIT 1
LV_WAYLAND_USE_EGL 1

LV_USE_OPENGLES 1
LV_USE_DRAW_EVGPU 1
LV_USE_EVGPU_LIB 0
LV_USE_DRAW_NANOVG 0
LV_USE_DRAW_OPENGLES 0
LV_USE_NANOVG 0

LV_USE_DRAW_EVGPUGANESH 0
LV_USE_DRAW_EVGPU_C_R_T 0

LV_USE_3DTEXTURE 1
LV_USE_3D_DRAW_TASKS 1
LV_USE_3DVIEWPORT 1
LV_USE_3DMESH 1
LV_USE_3DLIGHT 1
LV_USE_GLTF 0

LV_USE_EVDEV 0
LV_USE_LIBINPUT 0

LV_BUILD_EXAMPLES 0
LV_BUILD_DEMOS 1
LV_USE_DEMO_GLTF 0
LV_USE_DEMO_3DVIEWPORT 1
LV_USE_DEMO_3DSCENE 1
LV_USE_DEMO_3DVIEW 0
LV_USE_DEMO_WIDGETS 0
LV_USE_DEMO_KEYPAD_AND_ENCODER 0
LV_USE_DEMO_BENCHMARK 0
LV_USE_DEMO_RENDER 0
LV_USE_DEMO_VECTOR_GRAPHIC 0
LV_USE_DEMO_STRESS 0
LV_USE_DEMO_MUSIC 0
LV_USE_DEMO_EVGPU_BENCHMARK 1
LV_USE_DEMO_G3_SHOWCASE 1

LV_USE_LOG 1
LV_LOG_LEVEL LV_LOG_LEVEL_WARN
LV_LOG_PRINTF 1

LV_USE_SYSMON 1
LV_USE_PERF_MONITOR 1
LV_USE_PERF_MONITOR_LOG_MODE 1
LV_SYSMON_PROC_IDLE_AVAILABLE 1

LV_USE_PROFILER 1
LV_USE_PROFILER_BUILTIN 1
LV_USE_PROFILER_BUILTIN_POSIX 1
LV_PROFILER_INCLUDE "lv_profiler_builtin.h"
LV_PROFILER_BUILTIN_BUF_SIZE (16 * 1024)
LV_PROFILER_BUILTIN_DEFAULT_ENABLE 1
LV_PROFILER_LAYOUT 1
LV_PROFILER_REFR 1
LV_PROFILER_DRAW 1
LV_PROFILER_INDEV 1
LV_PROFILER_DECODER 1
LV_PROFILER_FONT 1
LV_PROFILER_FS 1
LV_PROFILER_STYLE 0
LV_PROFILER_TIMER 1
LV_PROFILER_CACHE 1
LV_PROFILER_EVENT 1

LV_USE_FLOAT 1
LV_USE_MATRIX 1
LV_USE_VECTOR_GRAPHIC 0
LV_USE_THORVG_INTERNAL 0
LV_USE_LOTTIE 0
LV_DRAW_TRANSFORM_USE_MATRIX 1

LV_ASSERT_HANDLER_INCLUDE <assert.h>
LV_ASSERT_HANDLER assert(0);

LV_USE_FS_STDIO 1
LV_FS_DEFAULT_DRIVER_LETTER 'A'
LV_FS_STDIO_LETTER 'A'

LV_DRAW_LAYER_SIMPLE_BUF_SIZE (256 * 1024)
LV_OBJ_STYLE_CACHE 1

LV_FONT_MONTSERRAT_14 1
LV_FONT_MONTSERRAT_16 1
LV_FONT_MONTSERRAT_20 1
LV_FONT_MONTSERRAT_22 1
LV_FONT_MONTSERRAT_24 1
LV_FONT_MONTSERRAT_26 1
LV_FONT_MONTSERRAT_30 1
LV_FONT_MONTSERRAT_36 1
LV_FONT_MONTSERRAT_40 1

LV_USE_STDLIB_MALLOC LV_STDLIB_CLIB
LV_USE_STDLIB_STRING LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF LV_STDLIB_CLIB
