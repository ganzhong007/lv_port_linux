# Orange Pi PC — SW DrawUnit + ThorVG VECTOR (no EVGPU / C_R_T)
# For SW vs C_R_T VECTOR comparison dumps.

LV_COLOR_DEPTH 32
LV_DEF_REFR_PERIOD 16

# Wayland SHM (CPU buffer; no EGL/GLES)
LV_USE_WAYLAND 1
LV_WAYLAND_WINDOW_DECORATIONS 0
LV_WAYLAND_DIRECT_EXIT 1
LV_WAYLAND_USE_EGL 0

LV_USE_OPENGLES 0
LV_USE_DRAW_EVGPU 0
LV_USE_DRAW_EVGPUGANESH 0
LV_USE_DRAW_EVGPU_C_R_T 0
LV_USE_DRAW_NANOVG 0
LV_USE_DRAW_OPENGLES 0
LV_USE_NANOVG 0

LV_USE_3DTEXTURE 0
LV_USE_3D_DRAW_TASKS 0
LV_USE_GLTF 0

LV_USE_EVDEV 0
LV_USE_LIBINPUT 0

LV_BUILD_EXAMPLES 0
LV_BUILD_DEMOS 1
LV_USE_DEMO_VECTOR_GRAPHIC 1
LV_USE_DEMO_EVGPU_BENCHMARK 0
LV_USE_DEMO_G3_SHOWCASE 0

LV_USE_FLOAT 1
LV_USE_MATRIX 1
LV_DRAW_TRANSFORM_USE_MATRIX 1

# VECTOR via SW + ThorVG
LV_USE_VECTOR_GRAPHIC 1
LV_USE_THORVG_INTERNAL 1
LV_USE_LOTTIE 0

LV_USE_SNAPSHOT 1

LV_FONT_DEFAULT &lv_font_montserrat_14
LV_FONT_MONTSERRAT_14 1
LV_FONT_MONTSERRAT_16 1
LV_FONT_MONTSERRAT_20 1
LV_FONT_MONTSERRAT_22 1
LV_FONT_MONTSERRAT_24 1
LV_FONT_MONTSERRAT_26 1
LV_FONT_MONTSERRAT_30 1
LV_FONT_MONTSERRAT_36 1
LV_FONT_MONTSERRAT_40 1

LV_USE_PERF_MONITOR 1
LV_MEM_CUSTOM 1
LV_DRAW_LAYER_SIMPLE_BUF_SIZE (256 * 1024)
LV_OBJ_STYLE_CACHE 1

LV_USE_STDLIB_MALLOC LV_STDLIB_CLIB
LV_USE_STDLIB_STRING LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF LV_STDLIB_CLIB

LV_ASSERT_HANDLER_INCLUDE <assert.h>
LV_ASSERT_HANDLER assert(0);

LV_USE_FS_STDIO 1
LV_FS_DEFAULT_DRIVER_LETTER 'A'
LV_FS_STDIO_LETTER 'A'

LV_USE_LOG 1
LV_LOG_LEVEL LV_LOG_LEVEL_WARN
LV_LOG_PRINTF 1

LV_USE_SYSMON 1
LV_USE_PERF_MONITOR_LOG_MODE 1
LV_SYSMON_PROC_IDLE_AVAILABLE 1
