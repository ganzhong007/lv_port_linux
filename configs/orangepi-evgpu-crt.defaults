# Orange Pi PC (Allwinner H3, Mali-400/lima, GLES2) — EVGPU_C_R_T optimized build
# Based on orangepi-evgpu.defaults with EVGPU_C_R_T instead of EVGPUGANESH

LV_COLOR_DEPTH 32
LV_DEF_REFR_PERIOD 16

# drivers: Wayland client + EGL
LV_USE_WAYLAND 1
LV_WAYLAND_WINDOW_DECORATIONS 0
LV_WAYLAND_DIRECT_EXIT 1
LV_WAYLAND_USE_EGL 1

# EVGPU family
LV_USE_OPENGLES 1
LV_USE_DRAW_EVGPU 1
LV_USE_EVGPU_LIB 0
LV_USE_DRAW_NANOVG 0
LV_USE_DRAW_OPENGLES 0

# EVGPUGANESH off, EVGPU_C_R_T on
LV_USE_DRAW_EVGPUGANESH 0
LV_USE_DRAW_EVGPU_C_R_T 1

LV_USE_NANOVG 0

# 3D widgets
LV_USE_3DTEXTURE 1
LV_USE_3D_DRAW_TASKS 1
LV_USE_3DVIEWPORT 1
LV_USE_3DMESH 1
LV_USE_3DLIGHT 1
LV_USE_GLTF 0

# Input: wayland provides input
LV_USE_EVDEV 0
LV_USE_LIBINPUT 0

# Examples/demos
LV_BUILD_EXAMPLES 0
LV_BUILD_DEMOS 1
LV_USE_DEMO_GLTF 0
LV_USE_DEMO_3DVIEWPORT 0
LV_USE_DEMO_3DSCENE 0
LV_USE_DEMO_3DVIEW 0
LV_USE_DEMO_EVGPU_BENCHMARK 1
LV_USE_DEMO_G3_SHOWCASE 1

# Math/matrix required by EVGPU image transforms
LV_USE_FLOAT 1
LV_USE_MATRIX 1
LV_DRAW_TRANSFORM_USE_MATRIX 1

# Vector/ThorVG off
LV_USE_VECTOR_GRAPHIC 0
LV_USE_THORVG_INTERNAL 0
LV_USE_LOTTIE 0

# Fonts
LV_FONT_DEFAULT &lv_font_montserrat_14
LV_FONT_MONTSERRAT_14 1
LV_FONT_MONTSERRAT_16 1
LV_FONT_MONTSERRAT_20 1
LV_FONT_MONTSERRAT_22 1
LV_FONT_MONTSERRAT_24 1
LV_FONT_MONTSERRAT_26 1
LV_FONT_MONTSERRAT_30 1
LV_FONT_MONTSERRAT_36 1
LV_FONT_MONTSERRAT_40 1
LV_FONT_MONTSERRAT_48 0
LV_FONT_MONTSERRAT_12 0
LV_FONT_MONTSERRAT_28 0
LV_FONT_MONTSERRAT_32 0

# Performance
LV_USE_PERF_MONITOR 1
LV_MEM_CUSTOM 1
LV_DRAW_LAYER_SIMPLE_BUF_SIZE (256 * 1024)
LV_OBJ_STYLE_CACHE 1

# Stdlib
LV_USE_STDLIB_MALLOC LV_STDLIB_CLIB
LV_USE_STDLIB_STRING LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF LV_STDLIB_CLIB

# Assert
LV_ASSERT_HANDLER_INCLUDE <assert.h>
LV_ASSERT_HANDLER assert(0);

# FS
LV_USE_FS_STDIO 1
LV_FS_DEFAULT_DRIVER_LETTER 'A'
LV_FS_STDIO_LETTER 'A'

# Logging
LV_USE_LOG 1
LV_LOG_LEVEL LV_LOG_LEVEL_WARN
LV_LOG_PRINTF 1

# Sysmon
LV_USE_SYSMON 1
LV_USE_PERF_MONITOR_LOG_MODE 1
LV_SYSMON_PROC_IDLE_AVAILABLE 1
