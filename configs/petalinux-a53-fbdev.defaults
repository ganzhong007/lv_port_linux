# PetaLinux AArch64 (ZynqMP) — Linux framebuffer + evdev
# Build: scripts/build_petalinux_fbdev.sh
# Run:   ./lvglsim -b fbdev -W 800 -H 480

LV_COLOR_DEPTH 32

LV_USE_LINUX_FBDEV 1
LV_LINUX_FBDEV_RENDER_MODE LV_DISPLAY_RENDER_MODE_DIRECT
LV_LINUX_FBDEV_BUFFER_COUNT 2

LV_USE_EVDEV 1
LV_USE_LIBINPUT 0

LV_USE_OPENGLES 0
LV_USE_GLFW 0
LV_USE_WAYLAND 0
LV_USE_LINUX_DRM 0
LV_USE_DRAW_GPU_RENDERER 0
LV_USE_GPU_RENDERER 0
LV_USE_3D 0
LV_USE_3D_WIDGETS 0

LV_BUILD_EXAMPLES 0
LV_BUILD_DEMOS 1
LV_USE_DEMO_WIDGETS 1

LV_USE_LOG 1
LV_LOG_LEVEL LV_LOG_LEVEL_WARN
LV_LOG_PRINTF 1

LV_USE_FLOAT 1
LV_USE_MATRIX 1

LV_USE_STDLIB_MALLOC LV_STDLIB_CLIB
LV_USE_STDLIB_STRING LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF LV_STDLIB_CLIB

LV_FONT_MONTSERRAT_14 1
LV_FONT_SOURCE_HAN_SANS_SC_14_CJK 1
